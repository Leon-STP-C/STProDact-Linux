# ST-PRO DACT - Docker deployment configuration.
# Copy this file to ".env" in the src directory and adjust the values.
# All variables are optional; the defaults used by compose.yaml are shown.

# Root password of the MySQL server inside the db container.
# NOTE: this is only applied when the mysql_data volume is first initialized.
MYSQL_ROOT_PASSWORD=root

# Database credentials for the application user (created by db/init.sh).
# The Windows installer hard-codes user "opcua" with password "opcua".
DB_NAME=opcua
DB_USER=opcua
DB_PASSWORD=opcua

# Host port on which the web application is reached. Defaults to 80 (the
# installer opens a firewall rule for TCP 80). If port 80 is already in use
# on the host, set this to a free port to avoid a conflict.
# The app itself always listens on port 3000 inside its container.
HTTP_PORT=80
